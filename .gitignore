# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used only for local development
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include example tfvars
!.tfvars.example

# CLI configuration files
.terraformrc
terraform.rc
